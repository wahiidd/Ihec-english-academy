# Copy to .env (never commit .env) and add the same variables in Vercel → Settings → Environment Variables.

# Supabase → Project → Connect → "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Gmail SMTP (app password, see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ihec.english.academy@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="IHEC English Academy <ihec.english.academy@gmail.com>"

# Admin area (/admin): login password + a long random string used to sign the session cookie
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-with-openssl-rand-hex-32
