---
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource/libre-caslon-text/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '../styles/global.css';
import { t, homePath, locale, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Adds hreflang alternates between the EN and FR home pages. */
  alternates?: boolean;
  noindex?: boolean;
}

const { lang, title, description, alternates = true, noindex = false } = Astro.props;
const dict = t(lang);
const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/images/og-image.png', site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0F2A5C" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonical} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(homePath('en'), site).href} />
          <link rel="alternate" hreflang="fr" href={new URL(homePath('fr'), site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(homePath('en'), site).href} />
        </>
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IHEC English Academy" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogAlt} />
    <meta property="og:locale" content={locale(lang).replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top">
    <slot />
  </body>
</html>
