---
import Page from '../Page.astro';
import { t, type Lang } from '../../../i18n/utils';

interface Props {
  lang: Lang;
  meta: { index: number; id?: string; head?: string };
}
const { lang, meta } = Astro.props;
const d = t(lang);
---

<Page {...meta} variant="grid" class="pillars-page">
  <p class="note note--lg ink" style="--d: 0">{d.sketch.pillarsNote}</p>
  <ol class="pillars">
    {
      d.about.pillars.map((p, i) => (
        <li class="rise" style={`--d: ${i * 2 + 1}`}>
          <span class="pillars__n">
            <svg class="draw" viewBox="0 0 64 64" aria-hidden="true" style={`--d: ${i * 2 + 1}`}>
              <path pathLength="1" d="M33 5 C 50 4, 60 18, 59 33 C 58 50, 45 60, 30 59 C 14 58, 4 46, 5 31 C 6 17, 17 7, 36 6" />
            </svg>
            <span>{i + 1}</span>
          </span>
          <div>
            <h3 lang="en">{p.title}</h3>
            <p>{p.text}</p>
          </div>
          {i < d.about.pillars.length - 1 && (
            <svg class="draw pillars__arrow" viewBox="0 0 40 60" aria-hidden="true" style={`--d: ${i * 2 + 2}`}>
              <path pathLength="1" d="M20 2 C 14 18, 26 34, 20 54 M12 46 L20 56 L28 46" />
            </svg>
          )}
        </li>
      ))
    }
  </ol>
</Page>
