---
import Page from '../Page.astro';
import { t, type Lang } from '../../../i18n/utils';

interface Props {
  lang: Lang;
  meta: { index: number; id?: string; head?: string };
}
const { lang, meta } = Astro.props;
const d = t(lang);
const p = d.pathway;
---

<Page {...meta} variant="paper">
  <p class="kicker-sm ink" style="--d: 0">{p.kicker}</p>
  <h2 class="h-title ink" style="--d: 1">{p.title}</h2>
  <ol class="path">
    <svg class="draw path__line" viewBox="0 0 20 400" preserveAspectRatio="none" aria-hidden="true" style="--d: 2">
      <path pathLength="1" vector-effect="non-scaling-stroke" d="M10 4 C 2 60, 18 120, 10 200 S 2 330, 10 396" />
    </svg>
    {
      p.steps.map((s, n) => (
        <li class="rise" style={`--d: ${n + 2}`}>
          <span class="path__n">{n + 1}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="note ink" style="--d: 7">{d.sketch.stepsNote} →</p>
</Page>
