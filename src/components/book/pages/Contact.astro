---
import Page from '../Page.astro';
import Icon from '../../Icon.astro';
import { site } from '../../../config/site';
import { t, type Lang } from '../../../i18n/utils';

interface Props {
  lang: Lang;
  meta: { index: number; id?: string; head?: string };
}
const { lang, meta } = Astro.props;
const d = t(lang);
const c = d.contact;
---

<Page {...meta} variant="ruled">
  <p class="kicker-sm ink" style="--d: 0">{c.kicker}</p>
  <h2 class="h-title ink" style="--d: 1">{c.title}</h2>
  <p class="body rise" style="--d: 2">{c.text}</p>
  <svg class="draw envelope" viewBox="0 0 120 80" aria-hidden="true" style="--d: 3">
    <path pathLength="1" d="M6 10 C 40 8, 80 9, 114 10 C 115 30, 114 52, 114 72 C 80 73, 40 72, 6 72 C 5 52, 6 30, 6 10 M6 12 C 30 32, 45 44, 60 50 C 75 44, 90 32, 114 12" />
  </svg>
  <ul class="contact-list">
    {
      site.email && (
        <li class="rise" style="--d: 4">
          <span class="contact-list__icon" aria-hidden="true"><Icon name="mail" size={20} /></span>
          <div>
            <p class="kicker-sm">{c.emailLabel}</p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </li>
      )
    }
    {
      site.socials.instagram && (
        <li class="rise" style="--d: 5">
          <span class="contact-list__icon" aria-hidden="true"><Icon name="instagram" size={20} /></span>
          <div>
            <p class="kicker-sm">Instagram</p>
            <a href={site.socials.instagram} target="_blank" rel="noopener noreferrer">@ihec.englishacademy</a>
          </div>
        </li>
      )
    }
    <li class="rise" style="--d: 6">
      <span class="contact-list__icon" aria-hidden="true"><Icon name="pin" size={20} /></span>
      <div>
        <p class="kicker-sm">{c.locationLabel}</p>
        <p>{c.location}</p>
      </div>
    </li>
  </ul>
  <p class="contact-legal">{d.footer.supervision} · © {new Date().getFullYear()} IHEC English Academy</p>
</Page>
