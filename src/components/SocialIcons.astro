---
import Icon from './Icon.astro';
import { site, type SocialNetwork } from '../config/site';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

const labels: Record<SocialNetwork, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  linkedin: 'LinkedIn',
  tiktok: 'TikTok',
  youtube: 'YouTube',
};
const networks = Object.keys(labels) as SocialNetwork[];
---

<ul class="socials">
  {
    networks.map((network) => {
      const url = site.socials[network];
      return (
        <li>
          {url ? (
            <a href={url} target="_blank" rel="noopener noreferrer" aria-label={labels[network]} title={labels[network]}>
              <Icon name={network} size={20} />
            </a>
          ) : (
            <span
              class="soon"
              role="img"
              aria-label={`${labels[network]} (${dict.contact.socialSoon})`}
              title={`${labels[network]} — ${dict.contact.socialSoon}`}
            >
              <Icon name={network} size={20} />
            </span>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: var(--rule-hair) solid var(--color-night-rule);
  }
  li {
    border-right: var(--rule-hair) solid var(--color-night-rule);
  }
  a,
  .soon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--color-on-night);
    transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }
  a:hover {
    background: var(--color-on-night);
    color: var(--color-night);
  }
  .soon {
    color: var(--color-on-night-muted);
    cursor: default;
  }
</style>
