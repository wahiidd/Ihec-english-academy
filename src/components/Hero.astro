---
/* H1 · Marquee — the academy's own motto is the statement; the four stages sit under one rule
   as the page's opening line (Narrative Workflow). No CTA in the fold. */
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const stages = [
  ['join', dict.stages.join],
  ['practise', dict.stages.practise],
  ['train', dict.stages.train],
  ['certify', dict.stages.certify],
] as const;
---

<section class="marquee">
  <div class="wrap">
    <h1 lang="en">
      {dict.hero.statement.map((word) => <span class="marquee__word">{word}<span class="marquee__stop">.</span></span>)}
    </h1>

    <nav class="marquee__index" aria-label={dict.hero.indexLabel}>
      <ol>
        {
          stages.map(([id, stage]) => (
            <li>
              <a href={`#${id}`}>
                <span class="marquee__num">{stage.numeral}</span>
                <span class="marquee__name">{stage.name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>

<style>
  .marquee {
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.6rem, 8vw + 0.5rem, 5.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .marquee__word {
    display: block;
  }
  .marquee__stop {
    color: var(--color-accent);
  }

  .marquee__index {
    margin-top: clamp(var(--space-xl), 6vw, var(--space-3xl));
    border-top: var(--rule-hair) solid var(--color-ink);
  }
  .marquee__index ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .marquee__index li {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .marquee__index li:nth-child(odd) {
    border-right: var(--rule-hair) solid var(--color-rule);
  }
  .marquee__index a {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    min-height: 44px;
    padding: var(--space-md) var(--space-sm);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .marquee__index a:hover .marquee__name {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }
  .marquee__num {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-accent);
    min-width: 2.2ch;
  }
  .marquee__name {
    font-weight: 600;
  }

  @media (min-width: 60rem) {
    .marquee__index ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .marquee__index li {
      border-bottom: 0;
    }
    .marquee__index li:not(:last-child) {
      border-right: var(--rule-hair) solid var(--color-rule);
    }
    .marquee__index a {
      padding: var(--space-lg) var(--space-md);
    }
    .marquee__index li:first-child a {
      padding-left: 0;
    }
  }
</style>
