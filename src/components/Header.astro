---
/* N6 · Newspaper masthead — issue line above · wordmark 2xl · double rule.
   Editorial default nav: the site reads as an issue of the academy, not as a SaaS bar. */
import { site } from '../config/site';
import { t, homePath, otherLang, launchDateLabel, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** On pages without the home sections (404), nav links point to the home page. */
  onHome?: boolean;
}

const { lang, onHome = true } = Astro.props;
const dict = t(lang).nav;
const other = otherLang(lang);
const base = onHome ? '' : homePath(lang);
const launchDate = launchDateLabel(lang);
const launched = Date.now() >= Date.parse(site.launchDate);

const links = [
  ['journey', dict.journey],
  ['team', dict.team],
  ['events', dict.events],
  ['contact', dict.contact],
] as const;
---

<header class="mast" data-mast>
  <div class="wrap">
    <div class="mast__line">
      <p class="mast__issue tnum">
        <span class="mast__school">IHEC Carthage</span>
        <span class="mast__school" aria-hidden="true">·</span>
        <span data-launch={site.launchDate} data-locale={lang}>
          <span data-launch-before hidden={launched}>
            {dict.launchBefore} {launchDate}<span data-launch-rel></span>
          </span>
          <span data-launch-after hidden={!launched}>{dict.launchAfter} {launchDate}</span>
        </span>
      </p>
      <a class="mast__lang" href={homePath(other)} hreflang={other} lang={other} data-lang-switch>
        {dict.switchShort}
      </a>
    </div>

    <a class="mast__name" href={homePath(lang)} aria-label={dict.home}>
      <picture>
        <source srcset="/images/emblem.webp" type="image/webp" />
        <img src="/images/emblem.png" alt="" width="240" height="192" fetchpriority="high" />
      </picture>
      <span>IHEC English Academy</span>
    </a>

    <nav class="mast__nav" aria-label={dict.primary}>
      <button class="mast__toggle" type="button" aria-expanded="false" aria-controls="mast-links" data-menu-toggle>
        <span data-label-open>{dict.menu}</span>
        <span data-label-close hidden>{dict.close}</span>
      </button>
      <ul id="mast-links" data-menu>
        {links.map(([id, label]) => <li><a href={`${base}#${id}`}>{label}</a></li>)}
      </ul>
    </nav>

    <hr class="mast__rule" aria-hidden="true" />
  </div>
</header>

<script>
  // Launch line: relative day count before the launch, "open since" after.
  const launch = document.querySelector<HTMLElement>('[data-launch]');
  if (launch) {
    const target = Date.parse(launch.dataset.launch ?? '');
    const before = launch.querySelector<HTMLElement>('[data-launch-before]')!;
    const after = launch.querySelector<HTMLElement>('[data-launch-after]')!;
    const rel = launch.querySelector<HTMLElement>('[data-launch-rel]')!;
    const diff = target - Date.now();
    if (diff > 0) {
      const days = Math.ceil(diff / 86_400_000);
      const rtf = new Intl.RelativeTimeFormat(launch.dataset.locale, { numeric: 'auto' });
      rel.textContent = ` · ${rtf.format(days, 'day')}`;
      before.hidden = false;
      after.hidden = true;
    } else {
      before.hidden = true;
      after.hidden = false;
    }
  }

  // Mobile disclosure for the link row.
  const mast = document.querySelector<HTMLElement>('[data-mast]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    mast?.classList.toggle('is-open', open);
    toggle?.querySelector<HTMLElement>('[data-label-open]')?.toggleAttribute('hidden', open);
    toggle?.querySelector<HTMLElement>('[data-label-close]')?.toggleAttribute('hidden', !open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mast?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Keep the current section when switching language.
  document.querySelector<HTMLAnchorElement>('[data-lang-switch]')?.addEventListener('click', (e) => {
    const link = e.currentTarget as HTMLAnchorElement;
    if (location.hash) link.href = link.pathname + location.hash;
  });
</script>

<style>
  .mast {
    padding-top: var(--space-md);
    text-align: center;
  }

  .mast__line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: var(--rule-hair) solid var(--color-rule-2);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .mast__issue {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    text-align: start;
  }
  [hidden] {
    display: none !important;
  }
  .mast__lang {
    flex-shrink: 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--color-brand);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .mast__lang:hover {
    text-decoration-thickness: 2px;
  }

  .mast__name {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 4.2vw + 0.4rem, 2.75rem);
    white-space: nowrap;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-brand);
    text-decoration: none;
  }
  .mast__name img {
    width: auto;
    height: 1.35em;
  }

  .mast__nav {
    margin-top: var(--space-md);
  }
  .mast__nav ul {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs) var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mast__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .mast__nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .mast__toggle {
    display: none;
    min-height: 44px;
    padding: 0 var(--space-lg);
    border: var(--rule-hair) solid var(--color-ink);
    border-radius: var(--radius-input);
    background: transparent;
    color: var(--color-ink);
    font: 600 var(--text-sm) / 1 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .mast__toggle:active {
    transform: translateY(1px);
  }

  .mast__rule {
    height: 4px;
    margin: var(--space-sm) 0 0;
    border: 0;
    border-top: var(--rule-hair) solid var(--color-ink);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }

  @media (max-width: 39.99rem) {
    .mast__school {
      display: none;
    }
    .mast__toggle {
      display: inline-flex;
      align-items: center;
    }
    .mast__nav ul {
      display: none;
    }
    .mast.is-open .mast__nav ul {
      display: flex;
      flex-direction: column;
      width: 100%;
      margin-top: var(--space-sm);
      gap: 0;
      text-align: start;
    }
    .mast.is-open .mast__nav li + li {
      border-top: var(--rule-hair) solid var(--color-rule-2);
    }
    .mast.is-open .mast__nav a {
      width: 100%;
      font-size: var(--text-md);
    }
  }
</style>
