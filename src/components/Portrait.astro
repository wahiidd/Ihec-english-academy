---
/* Team photo from src/assets/team/<slug>.(jpg|jpeg|png|webp), optimised by Astro;
   falls back to the person's initials until the photo is added. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  name: string;
  alt: string;
  /** Rendered width in CSS pixels (2× is generated for sharp screens). */
  width: number;
  class?: string;
}

const { slug, name, alt, width, class: className } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const photo = Object.entries(photos).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '').toLowerCase() === slug)?.[1].default;
const initials = name
  .split(/\s+/)
  .filter((w) => /^[A-ZÀ-Ý]/.test(w))
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---

{
  photo ? (
    <Image
      src={photo}
      alt={alt}
      width={width}
      height={Math.round(width * 1.25)}
      densities={[1, 2]}
      fit="cover"
      position="top"
      class:list={['portrait', className]}
      loading="lazy"
    />
  ) : (
    <div class:list={['portrait', 'portrait--initials', className]} role="img" aria-label={alt}>
      <span aria-hidden="true">{initials}</span>
    </div>
  )
}

<style>
  /* Global: astro:assets <Image> does not receive this component's scope attribute. */
  :global(.portrait) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
    border-radius: 16px;
    background: var(--bg-soft);
  }
  :global(.portrait--initials) {
    display: grid;
    place-items: center;
    background: var(--gradient);
    color: #fff;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
