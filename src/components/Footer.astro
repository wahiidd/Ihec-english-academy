---
/* Ft1 · Mast-headed — wordmark (the academy's own logo) anchors one band; contact + socials beside; credits below. */
import Icon from './Icon.astro';
import SocialIcons from './SocialIcons.astro';
import { site } from '../config/site';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const year = new Date().getFullYear();
---

<footer class="foot" id="contact">
  <div class="wrap">
    <div class="foot__band">
      <picture class="foot__logo">
        <source srcset="/images/logo-full-white.webp" type="image/webp" />
        <img src="/images/logo-full-white.png" alt={dict.hero.logoAlt} width="900" height="470" loading="lazy" />
      </picture>

      <div class="foot__contact">
        <dl>
          <div>
            <dt><Icon name="mail" size={18} /> {dict.contact.emailLabel}</dt>
            <dd>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span class="muted">{dict.contact.emailSoon}</span>}</dd>
          </div>
          <div>
            <dt><Icon name="pin" size={18} /> {dict.contact.locationLabel}</dt>
            <dd>{dict.contact.location}</dd>
          </div>
        </dl>
        <p class="foot__follow">{dict.contact.socialLabel}</p>
        <SocialIcons lang={lang} />
      </div>
    </div>

    <div class="foot__credits">
      <p>{dict.footer.supervision}</p>
      <p class="tnum">© {year} IHEC English Academy. {dict.footer.rights}</p>
      <a href="#top">{dict.footer.backToTop} <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--color-night);
    color: var(--color-on-night-muted);
    padding-top: var(--space-3xl);
  }
  .foot a {
    color: var(--color-on-night);
  }
  .foot :focus-visible {
    outline-color: var(--color-accent-on-night);
  }

  .foot__band {
    display: grid;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }
  @media (min-width: 60rem) {
    .foot__band {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
    }
  }
  .foot__logo img {
    width: min(100%, 30rem);
  }

  .foot__contact dl {
    display: grid;
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-on-night);
  }
  .foot__contact dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hair) solid var(--color-night-rule);
  }
  .foot__contact dt {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }
  .foot__contact dt :global(svg) {
    color: var(--color-accent-on-night);
  }
  .foot__contact dd {
    margin: 0;
    color: var(--color-on-night);
    text-align: end;
  }
  .foot__contact .muted {
    color: var(--color-on-night-muted);
    font-style: italic;
  }
  .foot__follow {
    margin: var(--space-lg) 0 var(--space-sm);
    font-size: var(--text-sm);
  }

  .foot__credits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-xl);
    padding-block: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-night-rule);
    font-size: var(--text-sm);
  }
  .foot__credits a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: auto;
    text-decoration: underline;
    text-decoration-color: var(--color-accent-on-night);
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .foot__credits a:hover {
    text-decoration-thickness: 2px;
  }
</style>
