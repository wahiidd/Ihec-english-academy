---
/* Events — hairline list with tabular dates; honest three-beat empty state until the first event is added. */
import { events } from '../data/events';
import { t, formatDate, launchDateLabel, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang).events;
const upcoming = events
  .filter((e) => Date.parse(e.date) >= Date.now())
  .sort((a, b) => Date.parse(a.date) - Date.parse(b.date));
---

<section class="events" id="events" aria-labelledby="events-title">
  <div class="wrap">
    <h2 id="events-title">{dict.title}</h2>
    {
      upcoming.length > 0 ? (
        <ol class="events__list">
          {upcoming.map((event) => (
            <li data-event-date={event.date}>
              <p class="events__date tnum">{formatDate(event.date, lang)}</p>
              <div>
                <h3>{event.title[lang]}</h3>
                {event.description && <p>{event.description[lang]}</p>}
                <p class="events__meta">
                  {dict.formats[event.format]}
                  {event.place && <> · {event.place[lang]}</>}
                  {' · '}
                  <span class="tnum">{formatDate(event.date, lang, { day: undefined, month: undefined, year: undefined, hour: '2-digit', minute: '2-digit' })}</span>
                </p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <div class="events__empty">
          <h3>{dict.emptyTitle}</h3>
          <p>{dict.emptyText.replace('{date}', launchDateLabel(lang))}</p>
          <a class="link" href="#contact">{dict.emptyAction} <span aria-hidden="true">→</span></a>
        </div>
      )
    }
  </div>
</section>

<script>
  // Hide events that have passed since the last build.
  document.querySelectorAll<HTMLElement>('[data-event-date]').forEach((el) => {
    if (Date.parse(el.dataset.eventDate ?? '') < Date.now()) el.hidden = true;
  });
</script>

<style>
  .events {
    padding-block: var(--space-2xl) var(--space-4xl);
  }
  .events__empty,
  .events__list {
    margin: var(--space-xl) 0 0;
    border-top: var(--rule-hair) solid var(--color-ink);
  }
  .events__empty {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
    padding-top: var(--space-lg);
    max-width: var(--measure);
  }
  .events__empty h3 {
    font-size: var(--text-lg);
  }
  .events__empty p {
    margin-bottom: var(--space-sm);
    color: var(--color-ink-2);
  }
  .events__list {
    padding: 0;
    list-style: none;
  }
  .events__list li {
    display: grid;
    gap: var(--space-xs) var(--space-xl);
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .events__list li[hidden] {
    display: none;
  }
  @media (min-width: 40rem) {
    .events__list li {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    }
  }
  .events__date {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-brand);
  }
  .events__list h3 {
    font-size: var(--text-lg);
  }
  .events__list p {
    color: var(--color-ink-2);
  }
  .events__meta {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
  }
</style>
