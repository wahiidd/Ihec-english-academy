---
/* Stage I · Join — the one real number on the page (30 DT) set as display type; C1 outlined chip. */
import Stage from './Stage.astro';
import { site } from '../config/site';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const m = dict.membership;
---

<Stage id="join" numeral={dict.stages.join.numeral} name={dict.stages.join.name} title={m.title} stageLabel={dict.stages.stage}>
  <p class="lead">{m.text}</p>

  <p class="price tnum">
    <span class="price__amount">{site.membershipFee}</span>
    <span class="price__unit">{m.currency} <span class="price__period">{m.period}</span></span>
  </p>

  <h4>{m.includesTitle}</h4>
  <ul class="includes">
    {m.includes.map((item) => <li>{item}</li>)}
  </ul>

  <div class="action">
    {
      site.joinUrl ? (
        <a class="chip" href={site.joinUrl} target="_blank" rel="noopener noreferrer">
          {m.cta} <span aria-hidden="true">→</span>
        </a>
      ) : (
        <>
          <span class="chip" aria-disabled="true">{m.soon}</span>
          <p class="note">{m.soonNote}</p>
        </>
      )
    }
  </div>
</Stage>

<style>
  .lead {
    font-size: var(--text-md);
    line-height: 1.5;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-block: var(--space-xl);
    font-family: var(--font-display);
    color: var(--color-brand);
  }
  .price__amount {
    font-size: var(--text-numeral);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .price__unit {
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .price__period {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-muted);
  }
  h4 {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .includes {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .includes li {
    display: flex;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .includes li::before {
    content: '—';
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .action {
    display: grid;
    justify-items: start;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    color: var(--color-brand);
  }
  .note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
