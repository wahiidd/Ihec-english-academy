---
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang).partner;
---

<section class="partner" aria-labelledby="partner-title">
  <div class="container partner__inner">
    <div class="partner__text">
      <p class="kicker">{dict.kicker}</p>
      <h2 id="partner-title">{dict.title}</h2>
      <p>{dict.text}</p>
    </div>
    <!-- British Council stays as text: replace with its official logo only once usage is authorised. -->
    <div class="partner__mark">
      <picture>
        <source srcset="/images/logo-full.webp" type="image/webp" />
        <img class="partner__logo" src="/images/logo-full.png" alt="IHEC Carthage English Academy" width="900" height="470" loading="lazy" />
      </picture>
      <span class="partner__plus" aria-hidden="true">×</span>
      <span class="partner__name">{dict.name}</span>
    </div>
  </div>
</section>

<style>
  .partner {
    padding-block: clamp(3rem, 7vw, 5rem);
    border-block: 1px solid var(--line);
  }
  .partner__inner {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .partner__inner {
      grid-template-columns: 1.3fr 0.7fr;
    }
  }
  .partner__text p:not(.kicker) {
    margin-top: 1rem;
    max-width: 40rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .partner__mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.75rem 1.5rem 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow);
    text-align: center;
  }
  .partner__mark picture {
    display: block;
    width: 100%;
  }
  .partner__logo {
    width: min(100%, 240px);
    height: auto;
    margin-inline: auto;
  }
  .partner__plus {
    font-size: 1.4rem;
    color: var(--teal-ink);
  }
  .partner__name {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--navy);
  }
</style>
