---
/* Stage IV · Certify — closing stage; the British Council partnership as a single hairline proof band (T2, text wordmark).
   Replace the text wordmark with the official logo only once its use is authorised. */
import Stage from './Stage.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const c = dict.certify;
---

<Stage id="certify" numeral={dict.stages.certify.numeral} name={dict.stages.certify.name} title={c.title} stageLabel={dict.stages.stage}>
  <p class="lead">{c.text}</p>
  <figure class="partner">
    <p class="partner__label">{c.partnerLabel}</p>
    <p class="partner__name">{c.partnerName}</p>
    <figcaption>{c.partnerText}</figcaption>
  </figure>
</Stage>

<style>
  .lead {
    font-size: var(--text-md);
    line-height: 1.5;
  }
  .partner {
    display: grid;
    gap: var(--space-2xs);
    margin: var(--space-xl) 0 0;
    padding-block: var(--space-lg);
    border-block: var(--rule-hair) solid var(--color-ink);
  }
  .partner__label {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .partner__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-brand);
  }
  figcaption {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
</style>
