---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  loggedIn?: boolean;
}
const { title, loggedIn = false } = Astro.props;
---

<Base lang="fr" title={`${title} — Admin IHEC English Academy`} alternates={false} noindex>
  <header class="admin-bar">
    <a class="admin-bar__brand" href="/admin">
      <img src="/images/emblem.png" alt="" width="240" height="192" />
      <span>Admin · IHEC English Academy</span>
    </a>
    {
      loggedIn && (
        <nav class="admin-bar__nav">
          <a href="/admin">Inscriptions</a>
          <a href="/admin/scan">Scanner</a>
          <form method="post" action="/api/admin/login">
            <button name="action" value="logout">Déconnexion</button>
          </form>
        </nav>
      )
    }
  </header>
  <main class="admin-main">
    <slot />
  </main>
</Base>

<style>
  .admin-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--navy);
    color: #fff;
  }
  .admin-bar__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
  }
  .admin-bar__brand img {
    width: auto;
    height: 30px;
    filter: brightness(0) invert(1);
  }
  .admin-bar__nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .admin-bar__nav a,
  .admin-bar__nav button {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.8rem;
    border: 0;
    border-radius: 8px;
    background: none;
    color: #fff;
    font: 600 0.9rem var(--font-sans);
    text-decoration: none;
    cursor: pointer;
  }
  .admin-bar__nav a:hover,
  .admin-bar__nav button:hover {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }
  .admin-main {
    width: min(100%, 1100px);
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
</style>
