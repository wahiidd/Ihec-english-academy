---
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang).ielts;
---

<section class="section" id="ielts">
  <div class="container ielts">
    <div class="ielts__intro">
      <p class="kicker">{dict.kicker}</p>
      <h2>{dict.title}</h2>
      <p class="ielts__lead">{dict.lead}</p>

      <div class="beyond">
        <h3>{dict.beyondTitle}</h3>
        <p>{dict.beyondText}</p>
        <ul class="tags">
          {dict.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
    </div>

    <ol class="skills">
      {
        dict.skills.map((skill, i) => (
          <li class="skill">
            <span class="skill__letter" aria-hidden="true">{skill.title[0]}</span>
            <div>
              <h3>{skill.title}</h3>
              <p>{skill.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ielts {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .ielts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ielts__lead {
    margin-top: 1rem;
    font-size: 1.075rem;
    color: var(--muted);
  }

  .beyond {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    border-left: 4px solid var(--teal);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--bg-soft);
  }
  .beyond h3 {
    margin-bottom: 0.4rem;
  }
  .beyond p {
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--navy);
  }

  .skills {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 560px) {
    .skills {
      grid-template-columns: 1fr 1fr;
    }
  }
  .skill {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--on-navy-muted);
  }
  .skill:nth-child(2),
  .skill:nth-child(3) {
    background: var(--navy-deep);
  }
  .skill h3 {
    color: #fff;
    margin-bottom: 0.35rem;
  }
  .skill p {
    font-size: 0.95rem;
  }
  .skill__letter {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--teal-light);
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--teal-light);
  }
</style>
