---
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang).ielts;
---

<section class="section" id="ielts">
  <div class="container ielts">
    <div class="ielts__intro">
      <p class="kicker">{dict.kicker}</p>
      <h2>{dict.title}</h2>
      <p class="ielts__lead">{dict.lead}</p>
    </div>

    <ol class="skills">
      {
        dict.skills.map((skill) => (
          <li class="skill">
            <span class="skill__letter" aria-hidden="true">{skill.title[0]}</span>
            <div>
              <h3 lang="en">{skill.title}</h3>
              <p>{skill.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="container which">
    <h3 class="which__title">{dict.whichTitle}</h3>
    <div class="which__grid">
      {
        dict.tests.map((test) => (
          <article class="test">
            <h4 lang="en">{test.title}</h4>
            <p>{test.text}</p>
          </article>
        ))
      }
    </div>
    <p class="which__note">{dict.whichNote}</p>
  </div>
</section>

<style>
  .ielts {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .ielts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ielts__lead {
    margin-top: 1rem;
    font-size: 1.075rem;
    color: var(--muted);
  }
  .skills {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 560px) {
    .skills {
      grid-template-columns: 1fr 1fr;
    }
  }
  .skill {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--on-navy-muted);
  }
  .skill:nth-child(2),
  .skill:nth-child(3) {
    background: var(--navy-deep);
  }
  .skill h3 {
    color: #fff;
    margin-bottom: 0.35rem;
  }
  .skill p {
    font-size: 0.95rem;
  }
  .skill__letter {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--teal-light);
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--teal-light);
  }

  .which {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .which__title {
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
  }
  .which__grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .which__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .test {
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius);
    background: var(--bg-soft);
    border-top: 4px solid var(--teal);
  }
  .test:last-child {
    border-top-color: var(--blue);
  }
  .test h4 {
    margin: 0 0 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--navy);
  }
  .test p {
    color: var(--muted);
  }
  .which__note {
    margin-top: 1rem;
    font-style: italic;
    color: var(--muted);
  }
</style>
