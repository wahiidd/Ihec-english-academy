---
/* Stage III · Train — the four IELTS papers as a hairline strip, initial set large. */
import Stage from './Stage.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const i = dict.ielts;
---

<Stage id="train" numeral={dict.stages.train.numeral} name={dict.stages.train.name} title={i.title} stageLabel={dict.stages.stage}>
  <p class="lead">{i.lead}</p>
  <ol class="papers" lang="en">
    {
      i.skills.map((skill) => (
        <li>
          <span class="papers__initial" aria-hidden="true">{skill.title[0]}</span>
          <h4>{skill.title}</h4>
          <p lang={lang}>{skill.text}</p>
        </li>
      ))
    }
  </ol>
  <p class="beyond">{i.beyond}</p>
</Stage>

<style>
  .lead {
    font-size: var(--text-md);
    line-height: 1.5;
  }
  .papers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-hair) solid var(--color-ink);
  }
  .papers li {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-md) var(--space-md) var(--space-lg) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  @media (min-width: 22rem) {
    .papers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .papers li:nth-child(even) {
      padding-left: var(--space-md);
      border-left: var(--rule-hair) solid var(--color-rule);
    }
  }
  .papers__initial {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 300;
    line-height: 1;
    color: var(--color-accent);
  }
  h4 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--color-brand);
  }
  .papers p {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .beyond {
    margin-top: var(--space-xl);
    font-style: italic;
    color: var(--color-muted);
  }
</style>
