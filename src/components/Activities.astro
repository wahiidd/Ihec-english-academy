---
/* Stage II · Practise — F3 Tabular spec sheet: format | what happens, hairline on every row. */
import Stage from './Stage.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const a = dict.activities;
---

<Stage id="practise" numeral={dict.stages.practise.numeral} name={dict.stages.practise.name} title={a.title} stageLabel={dict.stages.stage}>
  <p class="lead">{a.text}</p>
  <dl class="spec">
    {
      a.items.map((item) => (
        <div class="spec__row">
          <dt>
            {item.title}
            {item.key === 'workshops' && <span class="spec__tag">{a.hybrid}</span>}
          </dt>
          <dd>{item.text}</dd>
        </div>
      ))
    }
  </dl>
</Stage>

<style>
  .lead {
    font-size: var(--text-md);
    line-height: 1.5;
  }
  .spec {
    margin: var(--space-xl) 0 0;
    border-top: var(--rule-hair) solid var(--color-ink);
  }
  .spec__row {
    display: grid;
    gap: var(--space-2xs) var(--space-lg);
    padding-block: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  @media (min-width: 40rem) {
    .spec__row {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    }
  }
  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--color-brand);
  }
  .spec__tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  dd {
    margin: 0;
    color: var(--color-ink-2);
  }
</style>
