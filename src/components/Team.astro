---
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang).team;
---

<section class="section" id="team">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{dict.kicker}</p>
      <h2>{dict.title}</h2>
    </div>

    <div class="team">
      <article class="person person--lead">
        <!-- Replace the initials with a photo (e.g. /images/team/dorra-bechaouch.webp) when available. -->
        <div class="avatar" aria-hidden="true">DB</div>
        <div>
          <p class="person__role">{dict.directorRole}</p>
          <h3>{dict.directorName}</h3>
          <p class="person__title">{dict.directorTitle}</p>
        </div>
      </article>

      <article class="person person--ambassadors">
        <div class="avatars" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div>
          <p class="person__role">
            {dict.ambassadorsTitle} <span class="badge">{dict.comingSoon}</span>
          </p>
          <p class="person__text">{dict.ambassadorsText}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .team {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .team {
      grid-template-columns: 1fr 1fr;
    }
  }
  .person {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #fff;
  }
  @media (max-width: 479px) {
    .person {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: var(--gradient);
    color: #fff;
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 700;
    box-shadow: 0 0 0 5px #fff, 0 0 0 6px var(--line);
  }
  .person__role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-ink);
  }
  .person h3 {
    font-size: 1.45rem;
  }
  .person__title,
  .person__text {
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .avatars {
    display: flex;
    flex-shrink: 0;
  }
  .avatars span {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 3px solid #fff;
    background: var(--bg-soft);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .avatars span + span {
    margin-left: -18px;
  }
  .avatars span:nth-child(2) {
    background: rgb(58 155 213 / 0.18);
  }
  .avatars span:nth-child(3) {
    background: rgb(43 165 155 / 0.2);
  }
</style>
