---
/* People — typographic only (no avatars until real photos exist); two columns split by a vertical hairline. */
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang).team;
---

<section class="team" id="team" aria-labelledby="team-title">
  <div class="wrap">
    <h2 id="team-title">{dict.title}</h2>
    <div class="team__grid">
      <article class="person">
        <p class="person__role">{dict.directorRole}</p>
        <h3>{dict.directorName}</h3>
        <p class="person__title">{dict.directorTitle}</p>
      </article>
      <article class="person">
        <p class="person__role">{dict.ambassadorsTitle}</p>
        <p class="person__text">{dict.ambassadorsText}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .team {
    padding-block: var(--space-4xl) var(--space-2xl);
  }
  h2 {
    max-width: 20ch;
  }
  .team__grid {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
    border-top: var(--rule-hair) solid var(--color-ink);
    padding-top: var(--space-lg);
  }
  @media (min-width: 60rem) {
    .team__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 0;
    }
    .person + .person {
      padding-left: var(--space-xl);
      border-left: var(--rule-hair) solid var(--color-rule);
    }
    .person:first-child {
      padding-right: var(--space-xl);
    }
  }
  .person__role {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  h3 {
    margin-top: var(--space-xs);
    font-size: var(--text-2xl);
  }
  .person__title {
    margin-top: var(--space-xs);
    color: var(--color-ink-2);
  }
  .person__text {
    margin-top: var(--space-xs);
    max-width: 45ch;
    color: var(--color-ink-2);
  }
</style>
