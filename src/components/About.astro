---
/* Standfirst — the "what is this" paragraph in a 7/5 asymmetric split, facts as a hairline ledger. */
import { site } from '../config/site';
import { t, launchDateLabel, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const facts = [
  [dict.hero.facts.launch, launchDateLabel(lang)],
  [dict.hero.facts.supervision, dict.hero.facts.supervisionValue],
  [dict.hero.facts.focus, dict.hero.facts.focusValue],
  [dict.hero.facts.fee, `${site.membershipFee} ${dict.membership.currency} ${dict.membership.period}`],
];
---

<section class="standfirst" id="about">
  <div class="wrap standfirst__grid">
    <div class="standfirst__text">
      <p class="standfirst__lede">{dict.hero.lede}</p>
      <p class="standfirst__note">{dict.hero.supervision}</p>
    </div>
    <dl class="ledger tnum">
      {
        facts.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .standfirst {
    padding-block: 0 var(--space-3xl);
  }
  .standfirst__grid {
    display: grid;
    gap: var(--space-xl) var(--space-3xl);
  }
  @media (min-width: 60rem) {
    .standfirst__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: start;
    }
  }
  .standfirst__text {
    display: grid;
    gap: var(--space-lg);
    max-width: var(--measure);
  }
  .standfirst__lede {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.35;
    color: var(--color-ink);
  }
  .standfirst__note {
    color: var(--color-muted);
  }

  .ledger {
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-ink);
  }
  .ledger div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .ledger dt {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .ledger dd {
    margin: 0;
    font-weight: 600;
    color: var(--color-brand);
    text-align: end;
  }
</style>
