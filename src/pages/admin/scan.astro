---
import AdminShell from '../../components/AdminShell.astro';
import { isAdmin } from '../../lib/server/auth';

export const prerender = false;
if (!isAdmin(Astro.cookies)) return Astro.redirect('/admin?next=/admin/scan', 302);
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AdminShell title="Scanner" loggedIn>
  <div class="scan">
    <div class="scan__view">
      <video data-video playsinline muted></video>
      <div class="scan__frame" aria-hidden="true"></div>
      <div class="scan__result" data-result hidden>
        <p class="scan__icon" data-result-icon></p>
        <p class="scan__title" data-result-title></p>
        <p class="scan__name" data-result-name></p>
        <p class="scan__meta" data-result-meta></p>
      </div>
    </div>

    <p class="scan__status" data-status role="status">Démarrage de la caméra…</p>
    <p class="scan__count">Présences validées pendant cette session : <strong data-count>0</strong></p>

    <form class="scan__manual" data-manual>
      <label for="manual-code">Saisie manuelle</label>
      <div>
        <input id="manual-code" name="code" placeholder="Lien ou code du billet" autocomplete="off" />
        <button class="btn btn--primary">Valider</button>
      </div>
    </form>
  </div>
</AdminShell>

<script>
  import QrScanner from 'qr-scanner';

  const video = document.querySelector<HTMLVideoElement>('[data-video]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const box = document.querySelector<HTMLElement>('[data-result]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  let validated = 0;
  let busy = false;
  let lastCode = '';
  let lastAt = 0;

  const extractCode = (text: string) => {
    const m = text.trim().match(/(?:\/c\/|\/ticket\/)?([A-Za-z0-9_-]{22})(?:[/?#].*)?$/);
    return m?.[1];
  };

  const feedback = (tone: 'ok' | 'warn' | 'bad') => {
    navigator.vibrate?.(tone === 'ok' ? 120 : [80, 60, 80]);
    try {
      const ctx = new AudioContext();
      const osc = ctx.createOscillator();
      osc.frequency.value = tone === 'ok' ? 880 : 220;
      osc.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.15);
    } catch {}
  };

  const show = (tone: 'ok' | 'warn' | 'bad', title: string, name = '', meta = '') => {
    box.className = `scan__result scan__result--${tone}`;
    box.hidden = false;
    box.querySelector('[data-result-icon]')!.textContent = tone === 'ok' ? '✓' : tone === 'warn' ? '!' : '✕';
    box.querySelector('[data-result-title]')!.textContent = title;
    box.querySelector('[data-result-name]')!.textContent = name;
    box.querySelector('[data-result-meta]')!.textContent = meta;
    feedback(tone);
    setTimeout(() => (box.hidden = true), 2200);
  };

  const handle = async (raw: string) => {
    const code = extractCode(raw);
    // Ignore the same code read again within a few seconds (camera keeps seeing it).
    if (busy || (code && code === lastCode && Date.now() - lastAt < 4000)) return;
    lastCode = code ?? '';
    lastAt = Date.now();
    if (!code) return show('bad', 'QR code non reconnu');
    busy = true;
    try {
      const res = await fetch('/api/admin/checkin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code }),
      });
      if (res.status === 401) {
        location.href = '/admin?next=/admin/scan';
        return;
      }
      const r = await res.json();
      const when = r.checkedInAt
        ? new Intl.DateTimeFormat('fr-FR', { timeStyle: 'short', timeZone: 'Africa/Tunis' }).format(new Date(r.checkedInAt))
        : '';
      if (r.status === 'ok') {
        validated += 1;
        count.textContent = String(validated);
        show('ok', 'Présence validée', r.name, `${r.level} · ${r.event}`);
      } else if (r.status === 'already') {
        show('warn', 'Déjà scanné', r.name, `Entrée validée à ${when}`);
      } else {
        show('bad', 'Billet invalide');
      }
    } catch {
      show('bad', 'Erreur réseau — réessayez');
    } finally {
      busy = false;
    }
  };

  const scanner = new QrScanner(video, (result) => handle(result.data), {
    preferredCamera: 'environment',
    highlightScanRegion: false,
    maxScansPerSecond: 8,
  });
  scanner
    .start()
    .then(() => (status.textContent = 'Visez le QR code du billet.'))
    .catch(() => (status.textContent = 'Caméra indisponible. Autorisez l’accès à la caméra, ou utilisez la saisie manuelle.'));

  document.querySelector<HTMLFormElement>('[data-manual]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = (e.currentTarget as HTMLFormElement).elements.namedItem('code') as HTMLInputElement;
    lastCode = '';
    handle(input.value);
    input.value = '';
  });
</script>

<style>
  .scan {
    display: grid;
    gap: 1rem;
    max-width: 520px;
    margin: 0 auto;
  }
  .scan__view {
    position: relative;
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    background: #0a1d40;
  }
  .scan__view video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scan__frame {
    position: absolute;
    inset: 18%;
    border: 3px solid rgb(255 255 255 / 0.85);
    border-radius: 18px;
    box-shadow: 0 0 0 999px rgb(10 29 64 / 0.35);
  }
  .scan__result {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.3rem;
    padding: 1rem;
    text-align: center;
    color: #fff;
    animation: in 0.2s ease-out;
  }
  .scan__result[hidden] {
    display: none;
  }
  @keyframes in {
    from {
      opacity: 0;
    }
  }
  .scan__result--ok {
    background: rgb(21 122 79 / 0.94);
  }
  .scan__result--warn {
    background: rgb(178 94 9 / 0.94);
  }
  .scan__result--bad {
    background: rgb(165 42 31 / 0.94);
  }
  .scan__icon {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
  }
  .scan__title {
    font-size: 1.6rem;
    font-weight: 700;
  }
  .scan__name {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .scan__status,
  .scan__count {
    text-align: center;
    color: var(--muted);
  }
  .scan__count strong {
    color: var(--navy);
    font-size: 1.2rem;
  }
  .scan__manual {
    display: grid;
    gap: 0.4rem;
    padding: 1rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--line);
  }
  .scan__manual label {
    font-weight: 600;
    color: var(--navy);
  }
  .scan__manual div {
    display: flex;
    gap: 0.5rem;
  }
  .scan__manual input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 0.9rem;
    border: 1px solid #c3d2e1;
    border-radius: 10px;
    font: 500 1rem var(--font-sans);
  }
</style>
