---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { t } from '../i18n/utils';

const en = t('en').notFound;
const fr = t('fr').notFound;
---

<Base lang="en" title={`${en.title} — IHEC English Academy`} alternates={false} noindex>
  <Header lang="en" onHome={false} />
  <main class="wrap not-found">
    <p class="code tnum" aria-hidden="true">404</p>
    <h1>{en.title}</h1>
    <p>{en.text}</p>
    <p lang="fr" class="fr">{fr.title} — {fr.text}</p>
    <p class="actions">
      <a class="link" href="/">{en.back} <span aria-hidden="true">→</span></a>
      <a class="link" href="/fr/" lang="fr">{fr.back} <span aria-hidden="true">→</span></a>
    </p>
  </main>
</Base>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    padding-block: var(--space-3xl) var(--space-4xl);
  }
  .code {
    font-family: var(--font-display);
    font-size: var(--text-numeral);
    font-weight: 300;
    line-height: 1;
    color: var(--color-accent);
  }
  h1 {
    font-size: var(--text-3xl);
  }
  p {
    max-width: var(--measure);
    color: var(--color-ink-2);
  }
  .fr {
    font-style: italic;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    margin-top: var(--space-md);
  }
</style>
