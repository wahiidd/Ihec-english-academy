---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { t } from '../i18n/utils';

const en = t('en').notFound;
const fr = t('fr').notFound;
---

<Base lang="en" title={`${en.title} — IHEC English Academy`} alternates={false} noindex>
  <Header lang="en" onHome={false} />
  <main class="not-found">
    <img src="/images/emblem.png" alt="" width="240" height="192" />
    <p class="code">404</p>
    <h1>{en.title}</h1>
    <p>{en.text}</p>
    <p lang="fr" class="fr">{fr.title} — {fr.text}</p>
    <div class="actions">
      <a class="btn btn--primary" href="/">{en.back}</a>
      <a class="btn btn--ghost" href="/fr/" lang="fr">{fr.back}</a>
    </div>
  </main>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    min-height: calc(100vh - var(--header-h));
    padding: 4rem var(--gutter);
    text-align: center;
    justify-content: center;
    background: var(--bg-soft);
  }
  img {
    width: 110px;
  }
  .code {
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--teal-ink);
  }
  p {
    color: var(--muted);
    max-width: 34rem;
  }
  .fr {
    font-style: italic;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
